{
  "_comment": "Realistic visitor questions for the assistant (AST-04, PRD section 15: at least 90% answered correctly and in scope). `expect` lists the acceptable entry ids; ['FALLBACK'] means the assistant must decline instead of guessing. Run with: npm run check:assistant",
  "questions": [
    { "q": "Who are you?", "expect": ["about-me"] },
    { "q": "Can you tell me about yourself?", "expect": ["about-me"] },
    { "q": "What is your current job?", "expect": ["experience"] },
    { "q": "How many years of experience do you have?", "expect": ["experience"] },
    { "q": "Which company do you work for?", "expect": ["experience"] },
    { "q": "What did you do at Deepta AI?", "expect": ["experience"] },
    { "q": "Do you know Playwright?", "expect": ["tool-playwright"] },
    { "q": "Have you worked with Cucumber or BDD?", "expect": ["tool-cucumber"] },
    { "q": "Do you do manual testing?", "expect": ["capability-manual", "tool-manual-testing"] },
    { "q": "Can you automate tests?", "expect": ["capability-automation", "tool-automation-testing"] },
    { "q": "What testing tools do you use?", "expect": ["tools-overview", "category-Automation tools"] },
    { "q": "Do you know SQL?", "expect": ["tool-sql"] },
    { "q": "Which programming languages do you know?", "expect": ["category-Languages"] },
    { "q": "Tell me about your projects", "expect": ["projects-overview"] },
    { "q": "What was the CRM project about?", "expect": ["project-ams-client"] },
    { "q": "What is the product analytics project?", "expect": ["project-product-analytics"] },
    { "q": "What is the name of the AI platform you test?", "expect": ["FALLBACK", "project-product-analytics"] },
    { "q": "Have you built anything with React?", "expect": ["project-lab-portfolio"] },
    { "q": "Where did you study?", "expect": ["education"] },
    { "q": "What is your degree?", "expect": ["education"] },
    { "q": "How can I contact you?", "expect": ["contact"] },
    { "q": "What is your LinkedIn?", "expect": ["contact"] },
    { "q": "Are you open to work?", "expect": ["availability"] },
    { "q": "Where are you located?", "expect": ["location"] },
    { "q": "Do you use Jira?", "expect": ["tool-jira"] },
    { "q": "Do you work in Agile teams?", "expect": ["capability-agile", "tool-agile"] },
    { "q": "Do you know Jenkins or CI/CD?", "expect": ["tool-jenkins", "capability-pipeline", "category-Version control and CI/CD"] },
    { "q": "What is your salary expectation?", "expect": ["FALLBACK"] },
    { "q": "Do you know Java?", "expect": ["FALLBACK"] },
    { "q": "Do you know Python?", "expect": ["FALLBACK"] },
    { "q": "What is your favourite food?", "expect": ["FALLBACK"] },
    { "q": "Can you build me a mobile app?", "expect": ["FALLBACK"] },
    { "q": "Do you have a GitHub?", "expect": ["contact"] }
  ]
}
